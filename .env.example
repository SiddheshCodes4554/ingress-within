# ========================================================
# Ingress Within — Environment Configuration Template
# ========================================================

# Supabase Client Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Private Admin Key (Server-side only - Bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Signing Secret (For session access tokens)
JWT_SECRET=generate_a_secure_64_character_hex_string

# ========================================================
# OTP Authentication Provider Configuration
# Supported values: "msg91" | "supabase" | "fast2sms"
# ========================================================
OTP_PROVIDER=msg91

# MSG91 Production Configuration (Server-side only - NEVER prefix with NEXT_PUBLIC_)
# Set MSG91_AUTH_KEY to "mock_developer_key" for simulated local testing without live credits
MSG91_AUTH_KEY=mock_developer_key
MSG91_TEMPLATE_ID=your_msg91_dlt_template_id
MSG91_SENDER_ID=INGWRT
MSG91_OTP_EXPIRY=5

# Fast2SMS Integration Config (Fallback provider)
FAST2SMS_API_KEY=mock_developer_key
FAST2SMS_SENDER_ID=INGWRT
FAST2SMS_ROUTE=otp
FAST2SMS_DLT_TEMPLATE_ID=142857

# Upstash Redis Edge Rate Limiter Config (Optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Background Job Queue Connection (BullMQ)
REDIS_URL=redis://127.0.0.1:6379

# Active AI Provider Configuration: "claude" | "groq" | "gemini"
AI_PROVIDER=claude

# Anthropic Claude API Configuration
CLAUDE_API_KEY=your_anthropic_claude_api_key
CLAUDE_MODEL=claude-sonnet-5

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite

# Development & Feature Flags
NEXT_PUBLIC_ENABLE_TEST_PAGE=false
BYPASS_REDIS=true
