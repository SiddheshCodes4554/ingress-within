# Ingress Within — Authentication Environment Variables

# Next.js Public Client Configuration (Supabase url)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server Private Admin Key (Service Role - Bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Signing Secret (For access tokens)
JWT_SECRET=your-cryptographically-secure-jwt-signing-secret

# Fast2SMS Integration Config
# Set to "mock_developer_key" for simulated local testing without sending SMS
FAST2SMS_API_KEY=mock_developer_key
FAST2SMS_SENDER_ID=INGWRT

# Upstash Redis Edge Rate Limiter Config
# Leave blank to fallback automatically to database-backed rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Active OTP Provider Configuration
# Supported values: "supabase" (native Supabase phone OTP) or "fast2sms" (custom DB-backed)
OTP_PROVIDER=supabase

# Fast2SMS Route Configuration
# Supported values: "otp" (pre-approved templates, no registration) or "dlt" (custom template/sender)
FAST2SMS_ROUTE=otp
FAST2SMS_DLT_TEMPLATE_ID=142857

# Active AI Provider Configuration: "groq" | "claude"
AI_PROVIDER=groq

# Groq API Configuration
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude API Configuration
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Enable test playground page (/test) and pipeline endpoints in production
# Set to "true" to enable, leave blank or false to disable
NEXT_PUBLIC_ENABLE_TEST_PAGE=false

# Bypass Redis/BullMQ background queue processing and run pipeline inline synchronously
# Useful for dev testing in environments without Redis (like Vercel serverless functions)
BYPASS_REDIS=false
